VITTS_ENV=dev
VITTS_HTTP_ADDR=:8080
VITTS_DATABASE_URL=postgres://vitts:vitts@postgres:5432/vitts?sslmode=disable
VITTS_REDIS_URL=redis://redis:6379/0
VITTS_S3_ENDPOINT=http://minio:9000
VITTS_S3_BUCKET=vitts
VITTS_S3_REGION=us-east-1
VITTS_S3_ACCESS_KEY=vitts-dev
VITTS_S3_SECRET_KEY=vitts-dev-secret
VITTS_WORKER_ADDRS=worker:50051
VITTS_ADMIN_KEY=change-me-32-bytes
VITTS_ADMIN_IP_ALLOWLIST=127.0.0.1/32
VITTS_WEBHOOK_SIGNING_SECRET=change-me
VITTS_TEXT_ENCRYPTION_KEY=change-me-32-bytes-base64
VITTS_STREAM_QUEUE_TIMEOUT=2s
VITTS_SYNC_QUEUE_TIMEOUT=10s
VITTS_STREAM_SLOT_RESERVE_PCT=30
VITTS_LOG_LEVEL=info
# worker
VITTS_GRPC_ADDR=:50051
VITTS_MODEL_REPO=zeroweight-ai/ZeroTTS
VITTS_MODEL_REVISION=c2bfbd67dc648cac455077333f7cf5c18a2e3bb4
VITTS_MODEL_DIR=/var/lib/vitts/model   # weights are materialised here, one dir per revision
# VITTS_MODEL_MIRROR_S3=models         # key prefix in VITTS_S3_BUCKET; needs VITTS_S3_*
ORT_INTRA_OP_THREADS=8
VITTS_MAX_TEXT_CHARS=3000
